# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (safe to expose to the browser; unused server-side —
# the app never ships a Supabase client to the browser per architecture §5)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — service role, bypasses RLS. Server-only. Never NEXT_PUBLIC_.
# Read only in lib/dal/ and lib/auth/. See architecture §10, decision D4.
SUPABASE_SECRET_KEY=

# Signing secret for the guest session cookie (decision D3). Server-only, never NEXT_PUBLIC_.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_SESSION_SECRET=
