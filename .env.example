# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (safe to expose to the browser; unused server-side —
# the app never ships a Supabase client to the browser per architecture §5)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — service role, bypasses RLS. Server-only. Never NEXT_PUBLIC_.
# Read only in lib/dal/ and lib/auth/. See architecture §10, decision D4.
SUPABASE_SECRET_KEY=

# Signing secret for the guest session cookie (decision D3). Server-only, never NEXT_PUBLIC_.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_SESSION_SECRET=

# PayMongo secret key (test/sandbox for development — starts with sk_test_).
# Server-only, never NEXT_PUBLIC_. Used server-side to create/retrieve payment intents.
PAYMONGO_SECRET_KEY=

# PayMongo public key (test/sandbox for development — starts with pk_test_).
# Safe to expose to the browser — used client-side to attach a payment method to a
# PaymentIntent (GCash/Maya/card redirect flow).
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=

# PayMongo webhook signing secret (starts with whsec_). Server-only, never NEXT_PUBLIC_.
# Obtained after creating the webhook endpoint in the PayMongo dashboard (Developers > Webhooks),
# pointed at /api/webhooks/paymongo. Required to verify inbound webhook authenticity.
PAYMONGO_WEBHOOK_SECRET=
